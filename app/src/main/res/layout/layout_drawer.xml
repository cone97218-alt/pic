<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="276dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="酒馆匣"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDrawerTotalSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="0 B"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border" />

    <!-- Global Cross-Module Search Bar (inside Drawer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <EditText
            android:id="@+id/etDrawerGlobalSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="全库搜索..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnDrawerSearchClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Global Search Results Container (shown while searching) -->
    <TextView
        android:id="@+id/tvDrawerSearchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:text="未找到匹配资源"
        android:textColor="@color/text_muted"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDrawerGlobalSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Normal Workspace Navigation Group -->
    <LinearLayout
        android:id="@+id/drawerNavGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="10dp"
        android:text="工作区"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 1. 美化 -->
    <LinearLayout
        android:id="@+id/drawerItemThemes"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivDrawerThemes"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_theme"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvDrawerThemes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="美化"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCountThemes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 2. 角色卡 -->
    <LinearLayout
        android:id="@+id/drawerItemCharacters"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivDrawerCharacters"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_character"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvDrawerCharacters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="角色卡"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCountChars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3. 世界书 -->
    <LinearLayout
        android:id="@+id/drawerItemWorldBooks"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivDrawerWorldBooks"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_worldbook"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvDrawerWorldBooks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="世界书"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCountBooks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4. 预设 -->
    <LinearLayout
        android:id="@+id/drawerItemPresets"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivDrawerPresets"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_preset"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvDrawerPresets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="预设"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCountPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 5. 组件（正则 · 助手 · QR） -->
    <LinearLayout
        android:id="@+id/drawerItemComponents"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivDrawerComponents"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_component"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvDrawerComponents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="组件"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCountComps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/border" />

    <!-- Built-in Discord Web Hoarder (囤囤) -->
    <LinearLayout
        android:id="@+id/drawerItemHoard"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_nav_search"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="囤囤"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DC 网页"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Resource Inbox (收件箱) -->
    <LinearLayout
        android:id="@+id/drawerItemInbox"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_nav_vault"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="收件箱"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tvDrawerInboxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DC · 本地"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Tavern Bridge (酒馆互联) -->
    <LinearLayout
        android:id="@+id/drawerItemBridge"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_theme"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="酒馆互联"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tvDrawerBridgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未开启"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Activity Log (日志) -->
    <LinearLayout
        android:id="@+id/drawerItemLog"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_worldbook"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="日志"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部记录"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Duplicate & Near-Duplicate Organizer -->
    <LinearLayout
        android:id="@+id/drawerItemDedup"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_component"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="查重整理"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Settings Entry -->
    <LinearLayout
        android:id="@+id/drawerItemSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_module_preset"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="风格 · 分类"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
