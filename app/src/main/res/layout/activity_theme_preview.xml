<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Compact Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="美化预览"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewInstall"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="7dp"
            android:text="装入"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="7dp"
            android:text="设置"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePreview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="7dp"
            android:text="关闭"
            android:textColor="@color/accent"
            android:textSize="12.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Slim Variant Switcher Bar (only visible when >1 variant in same series) -->
    <LinearLayout
        android:id="@+id/layoutVariantBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnVariantPrev"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVariantPicker"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxWidth="220dp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:text="默认 (1/1) ▾"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVariantNext"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <WebView
            android:id="@+id/webPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pbPreviewLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
