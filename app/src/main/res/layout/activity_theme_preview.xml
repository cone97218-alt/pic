<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Unified Compact Top Bar (Title doubles as Variant Switcher when >1 variant exists) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/btnVariantPrev"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:paddingHorizontal="4dp"
            android:singleLine="true"
            android:text="美化预览"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVariantNext"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewInstall"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="5dp"
            android:text="装入"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewEditCode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="5dp"
            android:text="代码"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="5dp"
            android:text="设置"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePreview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="关闭"
            android:textColor="@color/accent"
            android:textSize="12.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <WebView
            android:id="@+id/webPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pbPreviewLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center" />

        <!-- Draggable Translucent Mini Background Pill (zero top-bar crowding) -->
        <LinearLayout
            android:id="@+id/boxPreviewBgFab"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="18dp"
            android:alpha="0.88"
            android:background="@drawable/bg_dock_item_active"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/btnPreviewBgPrev"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnPreviewBgSwitch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:text="背景"
                android:textColor="@color/on_accent"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreviewBgNext"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
