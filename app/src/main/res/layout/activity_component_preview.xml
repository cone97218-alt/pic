<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Minimalist Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvPreviewName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="沙盒预览"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPreviewDayNight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="浅色"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnPreviewModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="源码"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToggleTestBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="测试"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCompPreview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="关闭"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Greeting Switcher Bar (shown for multi-greeting character preview) -->
    <LinearLayout
        android:id="@+id/boxGreetingNav"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnGreetingPrev"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGreetingIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="默认开场白 · 1 / 1"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGreetingNext"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Collapsible Test Input Panel (for Regex testing or Greeting switcher) -->
    <LinearLayout
        android:id="@+id/boxRegexTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etTestInput"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="粘贴测试文本（如 AI 回复片段）..."
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRegexMatchStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="就绪"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunRegexTest"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="运行渲染"
                android:textColor="@color/on_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Render / Source Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webCompPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pbCompPreviewLoading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/text_muted"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scrollSourceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSourceCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
